  "cards": [
    {
      "dot": "cyan",
      "title": "面试主线",
      "items": [
        "CLI 负责交互与装配，AgentLoop 是模型—工具 ReAct 编排中心。",
        "context_builder 按预算组装 summary、todo、evidence 和 Memory。",
        "模型返回文本或 ToolCall，ToolRegistry 分发后把结果送回下一轮。"
      ]
    },
    {
      "dot": "rose",
      "title": "安全追问",
      "items": [
        "Shell 默认逐条审批，递归/批量删除硬拒绝；当前 Session 可授权明确前缀。",
        "文件写入和受控 Shell 先持久化 ToolAction，副作用不确定时不自动重试。",
        "TaskRuntime 用状态迁移、乐观锁和预算停止条件约束执行。"
      ]
    },
    {
      "dot": "emerald",
      "title": "扩展与可靠性",
      "items": [
        "SkillRegistry 先暴露元数据，匹配后按需加载并固定来源哈希。",
        "SubagentRunner 通过 delegate_task 创建受限 worker，并对结果做 review。",
        "SessionService 将 Session、Task、Trace、Action、Memory 写入工作区 SQLite。"
      ]
    }
  ]
