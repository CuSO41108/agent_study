  "cards": [
    {
      "dot": "cyan",
      "title": "面试主线",
      "items": [
        "CLI 装配 AgentLoop、PlanTaskService 与 SessionService；目标按复杂度进入两条路径。",
        "AgentLoop 组装上下文，调用模型并循环处理 ToolCall。",
        "结果、事件、Trace 与 Memory 经 SessionService 写入 SQLite。"
      ]
    },
    {
      "dot": "emerald",
      "title": "计划执行",
      "items": [
        "PlanPlanner 生成静态 DAG；PlanExecutor 按依赖、ResourceClaim 和 lease 调度。",
        "节点复用 AgentLoop 作用域；审批或 ask_user 只恢复原节点。",
        "失败可在 max_replans 内生成 successor revision，保留已完成证据。"
      ]
    },
    {
      "dot": "rose",
      "title": "恢复与安全",
      "items": [
        "每个 run_turn() 建立 ExecutionRun，并在暂停边界写 checkpoint。",
        "/resume /continue 从最新游标恢复；Shell 快照只保留命令哈希。",
        "不确定 ToolAction 先收敛证据，成功才接受效果，失败才重试。"
      ]
    }
  ]
